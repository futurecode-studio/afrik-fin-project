APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Configuration BRVM (Bourse Régionale des Valeurs Mobilières)
# Sources: RichBourse.com, BRVM.org (données africaines gratuites)
# Durée du cache en secondes (300 = 5 minutes)
BRVM_CACHE_DURATION=300
# Timeout des requêtes HTTP en secondes
BRVM_TIMEOUT=30

# Marketstack API Configuration (Legacy - optionnel)
# URL de base de l'API Marketstack
MARKETSTACK_API_URL=http://api.marketstack.com/v1
# Clé d'authentification API Marketstack (access_key)
MARKETSTACK_API_KEY=
# Durée du cache en secondes (300 = 5 minutes)
MARKETSTACK_CACHE_DURATION=300

# Configuration VL/FCP (Valeurs Liquidatives - Fonds Communs de Placement UEMOA)
# Source unique : Sikafinance (scraping HTML public, gratuit, sans clé API)
# Aucun fallback mock : si la source est indisponible, l'UI affiche un état vide.
MUTUAL_FUNDS_CACHE_DURATION=3600
MUTUAL_FUNDS_TIMEOUT=20

# KKiaPay Payment Gateway
# Obtenez vos clés sur https://kkiapay.me
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=
KKIAPAY_SANDBOX=true

# FedaPay Payment Gateway
# Obtenez vos clés sur https://fedapay.com (sandbox vs live)
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_API_URL=https://sandbox-api.fedapay.com/v1
FEDAPAY_SANDBOX=true

# FeexPay Payment Gateway
# Shop ID + API Token : https://app.feexpay.me → Développeur
# Docs: https://docs.feexpay.me
FEEXPAY_SHOP_ID=
FEEXPAY_API_KEY=
FEEXPAY_API_URL=https://api.feexpay.me
FEEXPAY_CALLBACK_URL=
FEEXPAY_SANDBOX=true

# Mansa API (sync BRVM serveur)
MANSA_API_KEY=
MANSA_API_BASE_URL=https://mansaapi.com
MANSA_TIMEOUT=20
MANSA_CACHE_TTL=1800
